<?xml version="1.0" encoding="utf-8"?>
<!-- Barra flotante de subtítulos: las últimas frases en español y (opcional) el inglés. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margen_pequeno"
    android:paddingEnd="@dimen/margen_pequeno">

    <LinearLayout
        android:id="@+id/contenedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_superposicion"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/texto_espanol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_traducido"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texto_ingles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_ingles"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
